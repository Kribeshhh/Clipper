# Run infrastructure/scripts/init-env.sh to generate a populated local .env.
POSTGRES_ADMIN_PASSWORD=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
POSTGRES_USER=clipper
POSTGRES_DB=clipper
LOG_LEVEL=INFO
CORS_ORIGINS=[]
OPERATOR_KEY=
MAX_UPLOAD_BYTES=536870912
MAX_DURATION_SECONDS=3600
MEDIA_TIMEOUT_SECONDS=300
# JSON overrides for highlight rank weights. Recreate the API after editing.
HIGHLIGHT_WEIGHTS='{"audio":1.2,"scene":0.8,"motion":1.2,"speech":0.8,"reaction":1.5}'
EXPORT_QUOTA_BYTES=5368709120
# Optional. Register the exact /api/providers/{youtube,twitch}/callback URLs.
# STUDIO_ORIGIN defaults to http://127.0.0.1:5173 in dev and :8080 in base Compose.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
OAUTH_ENCRYPTION_KEY=
LIVE_BUFFER_SECONDS=120
LIVE_BUFFER_BYTES=268435456
LIVE_IDLE_SECONDS=180
# Production TLS overlay reads certificate files from outside the build context.
# TLS_CERT_FILE=/absolute/path/to/studio.crt
# TLS_KEY_FILE=/absolute/path/to/studio.key
# STUDIO_ORIGIN=https://localhost:8443
RECORDING_QUOTA_BYTES=21474836480
# Direct HTTPS MP4 import worker limits (separate from browser upload limits)
IMPORT_MAX_BYTES=8589934592
IMPORT_MAX_DURATION_SECONDS=14400
IMPORT_DOWNLOAD_SECONDS=3600
IMPORT_VERIFY_SECONDS=1800
IMPORT_BYTES_PER_SECOND=8388608
IMPORT_RESERVE_BYTES=536870912

# Preferred automatic clip duration in seconds (hard ceiling 180)
AUTO_TARGET_MIN_SECONDS=20
AUTO_TARGET_MAX_SECONDS=60
